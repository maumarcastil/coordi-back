# ===========================================
# Coordi Backend - Variables de Entorno
# ===========================================
# Copiar este archivo a .env y configurar los valores

# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coordi
DB_MAX_CONNECTIONS=10

# Redis (caché)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=          # Descomentar si Redis requiere contraseña

# JWT (Autenticación)
JWT_SECRET=tu-secreto-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=7d
