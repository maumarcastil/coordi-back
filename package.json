{
	"name": "coordi-back",
	"version": "1.0.0",
	"description": "Backend API con Fastify y TypeScript",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsc",
		"start": "node --env-file=.env dist/index.js",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"format": "biome format --write src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run --dir src/application --dir src/domain --dir src/shared",
		"test:integration": "vitest run src/__tests__/integration",
		"test:e2e": "vitest run --dir src/__tests__/e2e",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.23.0",
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@fastify/postgres": "^6.0.2",
		"@fastify/redis": "^7.1.0",
		"@fastify/swagger": "^9.6.1",
		"@fastify/swagger-ui": "^5.2.3",
		"@fastify/websocket": "^11.2.0",
		"bcrypt": "^6.0.0",
		"fastify": "^5.6.2",
		"ioredis": "^5.8.2",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.16.3",
		"postgrator": "^8.0.0",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@testcontainers/postgresql": "^11.10.0",
		"@testcontainers/redis": "^11.10.0",
		"@types/bcrypt": "^6.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.0.3",
		"@types/pg": "^8.16.0",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^4.0.16",
		"testcontainers": "^11.10.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^6.0.3",
		"vitest": "^4.0.16"
	}
}
